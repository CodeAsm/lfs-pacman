pkgname=kbd
pkgver=2.6.4
pkgrel=1
pkgdesc="Keytable files and keyboard utilities"
arch=('x86_64')
url="http://www.kbd-project.org/"
license=('GPL')
source=(${pkgname}-${pkgver}.tar.xz
	${pkgname}-${pkgver}-backspace-1.patch)
sha256sums=('519f8d087aecca7e0a33cd084bef92c066eb19731666653dcc70c9d71aa40926'
            '8be28dcb11420624a500f2ea4fe975f771174bffee50e54ec8cd295a2dec104e')

prepare() {
    cd "${pkgname}-${pkgver}"

    patch -Np1 -i ../${pkgname}-${pkgver}-backspace-1.patch

    sed -i '/RESIZECONS_PROGS=/s/yes/no/' configure
    sed -i 's/resizecons.8 //' docs/man/man8/Makefile.in
}

build() {
    cd "${pkgname}-${pkgver}"
    ./configure --prefix=/usr --disable-vlock
    make
}

check() {
    cd "${pkgname}-${pkgver}"
    make check 2>&1 | tee ${pkgname}-${pkgver}-check-log
}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR=${pkgdir} install

    install -vdm755 ${pkgdir}/usr/share/doc/kbd-${pkgver}
    cp -Rv docs/doc/* ${pkgdir}/usr/share/doc/kbd-${pkgver}
}
