pkgname=setuptools
pkgver=72.2.0
pkgrel=1
pkgdesc="A tool used to download, build, install, upgrade, and uninstall Python packages"
arch=('x86_64')
url="https://pypi.python.org/pypi/setuptools"
source=($pkgname-$pkgver.tar.gz)
sha256sums=('80aacbf633704e9c8bfa1d99fa5dd4dc59573efcf9e4042c13d3bcef91ac2ef9')
license=('MIT')


build() {
    cd "$srcdir/$pkgname-$pkgver"
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD
}

package() {

    cd "$srcdir/$pkgname-$pkgver"

    pip3 install --root="$pkgdir" --prefix=/usr --no-index --no-user --find-links=dist setuptools

}