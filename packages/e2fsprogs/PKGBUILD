pkgname=e2fsprogs
pkgver=1.47.1
pkgrel=1
pkgdesc="Ext2/3/4 filesystem utilities"
arch=('x86_64')
url="http://e2fsprogs.sourceforge.net/"
license=('GPL' 'LGPL' 'MIT')
source=(${pkgname}-${pkgver}.tar.gz)
sha256sums=('9afcd201f39429d2db2492aeb13dba5e75d6cc50682b732dca35643bd5f092e3')

build() {
    cd "${pkgname}-${pkgver}"

    mkdir -v build
    cd build

    ../configure --prefix=/usr           \
                 --sysconfdir=/etc       \
                 --enable-elf-shlibs     \
                 --disable-libblkid      \
                 --disable-libuuid       \
                 --disable-uuidd         \
                 --disable-fsck

    make
}

check() {
    cd "${pkgname}-${pkgver}/build"
    make  check 2>&1 | tee ${pkgname}-${pkgver}-check-log
}

package() {
    cd ${pkgname}-${pkgver}/build

    make DESTDIR=${pkgdir} install

    gunzip -v ${pkgdir}/usr/share/info/libext2fs.info.gz
   
    makeinfo -o      doc/com_err.info ../lib/et/com_err.texinfo
    install -v -m644 doc/com_err.info ${pkgdir}/usr/share/info
    install-info --dir-file=${pkgdir}/usr/share/info/dir ${pkgdir}/usr/share/info/com_err.info
 }
