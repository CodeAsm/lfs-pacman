pkgname=expat
pkgver=2.6.4
pkgrel=1
pkgdesc="An XML parser library"
arch=('x86_64')
url="http://expat.sourceforge.net/"
license=('custom')
source=(${pkgname}-${pkgver}.tar.xz)
sha256sums=('a695629dae047055b37d50a0ff4776d1d45d0a4c842cf4ccee158441f55ff7ee')


build() {
    cd "${pkgname}-${pkgver}"
    ./configure --prefix=/usr \
    --disable-static          \
    --docdir=/usr/share/doc/expat-${pkgver}
    make
}

check() {
    cd "${pkgname}-${pkgver}"
    make check 2>&1 | tee ${pkgname}-${pkgver}-check-log
}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR=${pkgdir} install

    install -vdm755 ${pkgdir}/usr/share/doc/expat-${pkgver}
    install -vm644 doc/*.{html,css} ${pkgdir}/usr/share/doc/expat-${pkgver}
}
