pkgname=gmp
pkgver=6.3.0
pkgrel=1
pkgdesc="A free library for arbitrary precision arithmetic"
arch=('x86_64')
url="http://gmplib.org/"
license=('GPL' 'LGPL3')
source=(${pkgname}-${pkgver}.tar.xz)
sha256sums=('a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898')

build() {
    cd "${pkgname}-${pkgver}"
    ./configure --prefix=/usr    \
		--enable-cxx     \
		--disable-static \
		--docdir=/usr/share/doc/${pkgname}-${pkgver}
    make
    make html
}

check() {
    cd "${pkgname}-${pkgver}"
    make check 2>&1 | tee ${pkgname}-${pkgver}-check-log
    awk '/# PASS:/{total+=$3} ; END{print total}' ${pkgname}-${pkgver}-check-log
    echo "Ensure that at least 199 tests in the test suite passed"
    read -p "Please check test results and press any key to continue... " -n1 -s

}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR=${pkgdir} install
    make DESTDIR=${pkgdir} install-html
}