pkgname=flit_core
pkgver=3.9.0
pkgrel=1
pkgdesc="A packaging tool for simple Python modules"
arch=('x86_64')
url="https://flit.pypa.io/en/stable/"
source=($pkgname-$pkgver.tar.gz)
sha256sums=('72ad266176c4a3fcfab5f2930d76896059851240570ce9a98733b658cb786eba')
license=('MIT')


build() {

    cd "$srcdir/$pkgname-$pkgver"
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD

}

package() {

    cd "$srcdir/$pkgname-$pkgver"
    # Disabled the next command, as its a example from the wheel package.
   # pip3 install --root=$pkgdir --no-index $PWD 

    pip3 install --root="$pkgdir" --prefix=/usr --no-index --no-user --find-links dist flit_core

}