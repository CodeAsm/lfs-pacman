pkgname=jinja2
pkgver=3.1.4
pkgrel=1
pkgdesc="Python module that implements a simple pythonic template lanuage"
arch=('x86_64')
url="https://palletsprojects.com/p/jinja/"
source=($pkgname-$pkgver.tar.gz)
sha256sums=('4a3aee7acbbe7303aede8e9648d13b8bf88a429282aa6122a993f0ac800cb369')
license=('BSD')

build() {

    
    cd "${pkgname}-${pkgver}"
    pip3 wheel -w dist --no-cache-dir --no-build-isolation --no-deps $PWD

}

package() {
    
    cd "${pkgname}-${pkgver}"
    pip3 install --root=$pkgdir --no-index --no-user --find-links dist Jinja2

}