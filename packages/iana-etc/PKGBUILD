pkgname=iana-etc
pkgver=20240806
pkgrel=1
pkgdesc="/etc/protocols and /etc/services provided by IANA"
arch=('x86_64')
url="http://www.iana.org/protocols"
license=('custom:none')
source=(${pkgname}-${pkgver}.tar.gz)
sha256sums=('672dbe1ba52b889a46dc07ee3876664ed601983239f82d729d02a002475a5b66')

package() {
    cd "${pkgname}-${pkgver}"
    mkdir -p ${pkgdir}/etc
    cp services protocols ${pkgdir}/etc
}
