pkgname=vim
pkgver=9.1.0660
pkgrel=1
pkgdesc="Vi Improved, a highly configurable, improved version of the vi text editor"
arch=('x86_64')
url="http://www.vim.org/"
license=('custom:vim')
backup=('etc/vimrc')
source=(${pkgname}-${pkgver}.tar.gz
	vimrc)
sha256sums=('cf7d5c1fbde84357a355c1ad20118c8947d5e1684e71a673549f1e9635f9bfe7'
            'f395f9e52cb828348bd1e12f007d7344596b7acc1daeab46f035ef7cb91d41ba')

prepare() {
    cd "${pkgname}-${pkgver}"
    echo '#define SYS_VIMRC_FILE "/etc/vimrc"' >> src/feature.h
    sed -i '/call/{s/split/xsplit/;s/303/492/}' src/testdir/test_recover.vim
}

build() {
    cd "${pkgname}-${pkgver}"
    ./configure --prefix=/usr
    make
}

check() {
    cd "${pkgname}-${pkgver}"
    #make -j1 test 2>&1 > ${pkgname}-${pkgver}-check-log
}

package() {
    cd "${pkgname}-${pkgver}"
    make DESTDIR=${pkgdir} install

    ln -sv vim ${pkgdir}/usr/bin/vi
    for L in  ${pkgdir}/usr/share/man/{,*/}man1/vim.1; do
	    ln -sv vim.1 $(dirname $L)/vi.1
    done

    install -vdm755 ${pkgdir}/usr/share/doc/${pkgname}-${pkgver}
    ln -sv ../vim/vim90/doc ${pkgdir}/usr/share/doc/${pkgname}-${pkgver}

    install -vdm755 ${pkgdir}/etc
    install -vm644 ${srcdir}/vimrc ${pkgdir}/etc/vimrc

    # change ownership
    chown -R root:root "$pkgdir"
}
