pkgname=glibc
pkgver=2.40
pkgrel=1
pkgdesc="GNU C Library"
arch=('x86_64')
url="http://www.gnu.org/software/libc"
license=('GPL', 'LGPL')
backup=(etc/ld.so.conf)
source=(${pkgname}-${pkgver}.tar.xz
	glibc-2.40-fhs-1.patch
	nsswitch.conf
	ld.so.conf)
sha256sums=('19a890175e9263d748f627993de6f4b1af9cd21e03f080e4bfb3a1fac10205a2'
            '643552db030e2f2d7ffde4f558e0f5f83d3fabf34a2e0e56ebdb49750ac27b0d'
            '25b7973e937137c5af3fa477589d3929f1a09a229aeaba3c8a6e82e21b3b21bb'
            'a82b292e33d499a65c4946e3635b7765bc60631a68245d76370f35eea33322db')
install=glibc.install

prepare() {
    cd "${pkgname}-${pkgver}"
    patch -Np1 -i ../${pkgname}-${pkgver}-fhs-1.patch
}

build() {
    cd "${pkgname}-${pkgver}"

    mkdir -v build
    cd build

    GCC_INCDIR=/usr/lib/gcc/x86_64-pc-linux-gnu/7.2.0/include
    CC="gcc -isystem $GCC_INCDIR -isystem /usr/include" \
    ../configure --prefix=/usr                          \
                 --disable-werror                       \
		 --enable-kernel=3.2                    \
		 --enable-stack-protector=strong        \
		 libc_cv_slibdir=/lib
    unset GCC_INCDIR
    make
}

check() {
     cd "${pkgname}-${pkgver}"/build
     make check 2>&1 | tee ${pkgname}-${pkgver}-check-log
}

package() {
    cd "${pkgname}-${pkgver}"/build

    install -v -dm755 ${pkgdir}/etc
    touch ${pkgdir}/etc/ld.so.conf
    make install_root=${pkgdir} install

    install -v -dm755 ${pkgdir}/etc/nsdc
    install -v -m644 ${srcdir}/${pkgname}-${pkgver}/nscd/nscd.conf ${pkgdir}/etc/nscd.conf
    install -v -dm755 ${pkgdir}/var/cache/nscd

    install -v -dm755 ${pkgdir}/usr/lib/locale

    install -v -m644 ${srcdir}/nsswitch.conf ${pkgdir}/etc/nsswitch.conf

    install -v -m644 ${srcdir}/ld.so.conf ${pkgdir}/etc/
    install -v -dm755 ${pkgdir}/etc/ld.so.conf.d
}
