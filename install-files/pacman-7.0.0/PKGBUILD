pkgname=pacman
pkgver=7.0.0
pkgrel=1
pkgdesc="A library-based package manager with dependency support"
arch=('x86_64')
url="http://www.archlinux.org/pacman/"
license=('GPL')
backup=(etc/pacman.conf etc/makepkg.conf)
source=(${pkgname}-${pkgver}.tar.xz
        pacman.conf
        makepkg.conf)
sha256sums=(61cbd445d1381b4b184bc7c4e2791f07a79f0f2807b7c600399d0d08e8cd28cf
    6b4cb2fe88984474ae65766a1ab2f7b13799113fd26e019161fbbf4dfa780c08
    6066d67d818ee36760bf121c76d5019130f7875b3e5ed179b319b810a3a9685b
)

build() {
    cd "$pkgname-$pkgver"
    cp ../../meson.pyz .

	python3 meson.pyz setup --prefix=/usr             \
			  --buildtype=plain               \
			  -Ddoc=disabled                  \
			  -Ddoxygen=enabled               \
			  -Dscriptlet-shell=/usr/bin/bash \
			  -Dldconfig=/usr/bin/ldconfig    \
			  build
	python3 meson.pyz compile -C build
}

package() {
    cd "$pkgname-$pkgver"
    cp ../../meson.pyz .
   DESTDIR="$pkgdir" ../../meson.pyz install -C build  
   # install Arch specific stuff  
    install -dm755 "$pkgdir/etc"   
    install -m644 "$srcdir/pacman.conf" "$pkgdir/etc"   
    install -m644 "$srcdir/makepkg.conf" "$pkgdir/etc"   
    # These next two are in the official arch pkgbuild, but I don't know if we need em.
    # feel free to fix this yourself.
    #install -D -m644 "$srcdir/alpm.sysusers" "${pkgdir}"/usr/lib/sysusers.d/alpm.conf   
    #install -m644 "$srcdir/rust.conf" "$pkgdir/etc/makepkg.conf.d"   
    
    local wantsdir="$pkgdir/usr/lib/systemd/system/sockets.target.wants"   
    install -dm755 "$wantsdir"   
    
    local unit   
	for unit in dirmngr gpg-agent gpg-agent-{browser,extra,ssh} keyboxd; do
	   ln -s "../${unit}@.socket" "$wantsdir/${unit}@etc-pacman.d-gnupg.socket"
   done   
}
